{
  "$schema": "https://raw.githubusercontent.com/LedgerHQ/clear-signing-erc7730-registry/master/specs/erc7730-v2.schema.json",
  "context": {
    "eip712": {
      "deployments": [
        { "chainId": 84532, "address": "0x47c7AbB1FfbF37eD4bCFCB20f6648B5c0cC86123" }
      ],
      "domain": {
        "name": "SUBFLOOR FloorRegistry",
        "version": "1"
      }
    }
  },
  "metadata": {
    "owner": "SUBFLOOR",
    "info": {
      "legalName": "SUBFLOOR",
      "url": "https://github.com/zexoverz/subfloor"
    }
  },
  "display": {
    "formats": {
      "FloorLowering(address recipient,address base,address quote,uint16 maxAdverseBps,uint256 absoluteRate,uint256 nonce,uint256 deadline)": {
        "intent": "Weaken a price floor",
        "fields": [
          { "path": "recipient", "label": "Protects", "format": "addressName", "visible": "always" },
          { "path": "base", "label": "Giving", "format": "addressName", "visible": "always" },
          { "path": "quote", "label": "Receiving", "format": "addressName", "visible": "always" },
          { "path": "maxAdverseBps", "label": "New tolerance (bps below reference)", "format": "raw", "visible": "always" },
          { "path": "absoluteRate", "label": "New backstop rate", "format": "raw", "visible": "always" },
          { "path": "deadline", "label": "Signature valid until", "format": "date", "params": { "encoding": "timestamp" }, "visible": "always" },
          { "path": "nonce", "label": "Nonce", "format": "raw" }
        ],
        "required": ["recipient", "base", "quote", "maxAdverseBps", "absoluteRate", "deadline"]
      },
      "GuardianRotation(address recipient,address newGuardian,uint256 nonce,uint256 deadline)": {
        "intent": "Hand the guardian role to a new key",
        "fields": [
          { "path": "recipient", "label": "For", "format": "addressName", "visible": "always" },
          { "path": "newGuardian", "label": "New guardian", "format": "addressName", "visible": "always" },
          { "path": "deadline", "label": "Signature valid until", "format": "date", "params": { "encoding": "timestamp" }, "visible": "always" },
          { "path": "nonce", "label": "Nonce", "format": "raw" }
        ],
        "required": ["recipient", "newGuardian", "deadline"]
      }
    }
  }
}
