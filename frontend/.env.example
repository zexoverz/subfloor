# The shape of the frontend's configuration. Copy to .env.local and fill it in.
#
# Every one of these is read by Vite at build time and baked into the bundle, so an empty value
# here is not a missing setting at runtime — it is compiled out. That failure is silent and it
# already happened: the production image built and served perfectly with all of them empty, so the
# wallet could not connect and every contract address was the empty string.
#
# None of them are secrets. All of them end up in a file the browser downloads. The secrets in this
# project are the ones the server reads at runtime and they live elsewhere.
#
# The current addresses are in the README's deployment table, which is the one place they are
# recorded per chain. When a contract is redeployed, that table moves first and this follows.

# WalletConnect / Reown. Without it the connect button throws rather than opening nothing.
VITE_REOWN_PROJECT_ID=

# `base` selects Base mainnet. Anything else, including empty, selects Base Sepolia.
VITE_CHAIN=

# The deployment. Registry and router are the mechanism; the vault is ours, and the factory is what
# a visitor deploys their own through.
VITE_FLOOR_REGISTRY=
VITE_FLOOR_ROUTER=
VITE_VAULT=
VITE_VAULT_FACTORY=

# Aqua. Ours on a testnet, canonical 0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a on a mainnet.
VITE_AQUA=

# The index. `version/latest` follows a republished subgraph; a pinned version does not.
VITE_SUBGRAPH_URL=

# Testnet only, and optional. With it, the fund step offers to draw tokens instead of ending at
# "fund the wallet first"; without it, that button is not rendered at all.
VITE_FAUCET=

# --- server side, read at runtime by the functions in `api/` ------------------------------------
#
# These are NOT baked into the bundle and NOT public. They are set in the hosting provider's
# environment, not here. Listed because every one of them was previously undocumented, and a
# deployment missing `SUBFLOOR_HYPERSYNC_TOKEN` fails at the first request rather than at build.

# Required. Log and transaction history goes through Envio HyperSync; `eth_getLogs` is forbidden in
# this repo, so there is no fallback and code that cannot find this throws and says so.
SUBFLOOR_HYPERSYNC_TOKEN=

# Optional overrides. Each defaults to the Base Sepolia deployment in the README's table.
SUBFLOOR_HYPERSYNC_URL=
SUBFLOOR_SUBGRAPH=
SUBFLOOR_RPC=
SUBFLOOR_ROUTER=
SUBFLOOR_AGGREGATOR=
SUBFLOOR_WETH=
SUBFLOOR_QUOTE=
SUBFLOOR_FROM_BLOCK=
